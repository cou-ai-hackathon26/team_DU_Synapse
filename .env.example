# Server settings. Copy to .env or inject into the FastAPI deployment environment.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# Optional comma-separated keys from separate Gemini projects. When set, the
# pool takes precedence over GEMINI_API_KEY and rotates requests between projects.
GEMINI_API_KEYS=
# Structured extraction and verification provider. Gemini remains the default.
# xAI can replace structured generation while Gemini continues to provide the
# existing 768-dimensional retrieval embeddings.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
XAI_API_KEY=
XAI_API_URL=https://api.x.ai/v1
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low
EMBEDDING_MODEL=gemini-embedding-001
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set from this Gemini project's permitted rate.
MIN_REQUEST_INTERVAL=1
# Minimum spacing between requests sent through the same key in a multi-key pool.
GEMINI_KEY_MIN_INTERVAL=6

# Enable only on Vercel deployments; local development uses the leased worker loop.
QUEUE_ENABLED=false

# Reviewer invite origin and first administrator (set private values in .env).
APP_URL=http://localhost:3000
ADMIN_EMAIL=
ADMIN_PASSWORD=
